{
  "name": "plumb",
  "version": "0.2.5",
  "private": true,
  "description": "Opinionated Oxlint rules that keep TypeScript true — generic and Effect-specific patterns, maintained as one source of truth for the autotelic repos.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./meta": "./src/meta/index.ts"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:rule-tests",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:rule-tests": "node scripts/check-rule-tests.mjs"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fast-check": "^4.9.0",
    "oxlint": "1.79.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
