{
  "name": "plumb",
  "version": "0.1.0",
  "private": true,
  "description": "Opinionated Oxlint rules that keep TypeScript true — generic and Effect-specific patterns, maintained as one source of truth for the autotelic repos.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.79.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
